# Werte für Azure Container Apps als "secrets" hinterlegen, NICHT im Image.
# Terraform setzt diese automatisch als Environment-Variablen im Container.

SECRET_KEY=<per Terraform-Variable gesetzt, siehe terraform.tfvars>
JWT_SECRET_KEY=<per Terraform-Variable gesetzt, siehe terraform.tfvars>
FLASK_ENV=production

# Azure SQL Database (Serverless, Free-Tier) via pymssql statt pyodbc:
# Format: mssql+pymssql://<user>:<pass>@<server>.database.windows.net:1433/<db>
DATABASE_URL=mssql+pymssql://sqladmin:CHANGE_ME@sql-scooter-vicc.database.windows.net:1433/scooter_db
