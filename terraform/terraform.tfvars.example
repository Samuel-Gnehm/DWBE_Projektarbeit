unique_suffix       = "sg01"                                    # kurz, deine Initialen o.ä.
sql_admin_user      = "sqladmin"
sql_admin_password  = "CHANGE_ME_STRONG_PASSWORD_123!"
flask_secret_key    = "CHANGE_ME_RANDOM_STRING"
jwt_secret_key      = "CHANGE_ME_ANOTHER_RANDOM_STRING"
docker_image        = "docker.io/<dein-dockerhub-user>/scooter-app:latest"

# Kopiere diese Datei zu terraform.tfvars (ohne .example) und trag echte Werte ein.
# terraform.tfvars gehört NICHT ins Git-Repo (steht schon in .gitignore? sonst ergänzen).
